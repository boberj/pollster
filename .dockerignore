# Built inside the image, so local copies would only slow down sending the build context.
build/
.gradle/
.kotlin/
node_modules/

# Local data must never end up in an image.
data/
*.db
*.db-shm
*.db-wal
# The copies jetlin-db makes before migrating, such as pollster.db.before-0002_lock_links_after_first_visit.
*.db.before-*

.git/
.idea/
